{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newseviday-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_VERSION": "0.1.0",
    "RUNTIME_MODE": "archive",
    "AI_ENABLED": "false",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
  },
}
