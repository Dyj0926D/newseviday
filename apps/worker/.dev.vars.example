# Only used by the standalone API fallback config in this directory.
DEEPSEEK_API_KEY=replace_with_personal_key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_ENABLED=false
# Required before AI_ENABLED=true. Confirm current prices in the provider console.
DEEPSEEK_INPUT_CNY_PER_MILLION=3
DEEPSEEK_OUTPUT_CNY_PER_MILLION=6
IP_HASH_SECRET=generate_a_random_value_with_at_least_32_characters
TRACE_HASH_SECRET=generate_a_separate_random_value_with_at_least_32_characters
# Cloudflare official dummy keys. Use only in local development/test.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
