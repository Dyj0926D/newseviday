{
  "name": "@newseviday/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src vite.config.ts --max-warnings=0"
  },
  "dependencies": {
    "@newseviday/contracts": "*",
    "@newseviday/design-tokens": "*",
    "@phosphor-icons/vue": "^2.2.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
