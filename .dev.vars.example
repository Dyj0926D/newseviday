# Copy to .dev.vars for the root Cloudflare Worker configuration. Never commit real values.
# Keep AI_ENABLED=false and RAG_ENABLED=false until the controlled-trial preflight passes.
DEEPSEEK_API_KEY=replace_with_personal_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_ENABLED=false
# Conservative peak-price estimate as of 2026-09-01. Recheck before enabling AI.
DEEPSEEK_INPUT_CNY_PER_MILLION=4
DEEPSEEK_OUTPUT_CNY_PER_MILLION=12
RAG_RETRIEVAL_MODE=chunk_bm25
RAG_MIN_SCORE=1.5
IP_HASH_SECRET=generate_a_random_value_with_at_least_32_characters
TRACE_HASH_SECRET=generate_a_separate_random_value_with_at_least_32_characters
# Cloudflare official dummy keys. Use only in local development/test.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
