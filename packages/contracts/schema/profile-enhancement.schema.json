{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newseviday.dev/schema/profile-enhancement-v1.json",
  "title": "NewsEviday Profile Enhancement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "work", "goal", "description", "interests", "inferredTerms", "warnings"],
  "properties": {
    "role": { "type": "string", "maxLength": 80 },
    "work": { "type": "string", "maxLength": 200 },
    "goal": { "type": "string", "maxLength": 240 },
    "description": { "type": "string", "maxLength": 500 },
    "interests": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topicId", "weight", "reason"],
        "properties": {
          "topicId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "weight": { "type": "integer", "minimum": 1, "maximum": 5 },
          "reason": { "type": "string", "minLength": 2, "maxLength": 120 }
        }
      }
    },
    "inferredTerms": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string" }
    }
  }
}
