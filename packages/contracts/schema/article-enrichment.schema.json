{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newseviday.dev/schema/article-enrichment-v1.json",
  "title": "NewsEviday Article Enrichment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["titleZh", "summaryZh", "whyItMatters", "keyPoints", "topicIds"],
  "properties": {
    "titleZh": { "type": "string", "minLength": 2, "maxLength": 160 },
    "summaryZh": { "type": "string", "minLength": 20, "maxLength": 800 },
    "whyItMatters": { "type": "string", "minLength": 10, "maxLength": 300 },
    "keyPoints": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "topicIds": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true
    }
  }
}
