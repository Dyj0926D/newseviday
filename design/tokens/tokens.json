{
  "$schemaVersion": "1.0",
  "meta": {
    "product": "NewsEviday",
    "version": "1.0",
    "status": "frozen",
    "theme": "light",
    "prefix": "ne"
  },
  "color": {
    "primitive": {
      "white": "#FFFFFF",
      "black": "#000000",
      "purple": {
        "50": "#F6F3FF",
        "100": "#EEE9FF",
        "200": "#DED4FF",
        "300": "#C7B8F5",
        "400": "#9E86E8",
        "500": "#7257D5",
        "600": "#6246C7",
        "700": "#5135AA",
        "800": "#40298A",
        "900": "#32226A"
      }
    },
    "semantic": {
      "background": {
        "page": "#F5F3FA",
        "surface": "#FFFFFF",
        "subtle": "#FAF9FC",
        "tinted": "#F0ECFC",
        "inverse": "#1B1824"
      },
      "text": {
        "strong": "#1B1824",
        "default": "#312D3D",
        "secondary": "#625D70",
        "muted": "#706A7B",
        "disabled": "#9B96A5",
        "inverse": "#FFFFFF"
      },
      "border": {
        "subtle": "#E9E5EF",
        "default": "#D9D4E2",
        "strong": "#B9B2C5"
      },
      "brand": {
        "subtle": "#EEE9FF",
        "default": "#7257D5",
        "hover": "#6246C7",
        "active": "#5135AA"
      },
      "focus": "#8B6FE8",
      "success": {
        "default": "#2F7D5A",
        "subtle": "#EAF6EF"
      },
      "warning": {
        "default": "#8A5B12",
        "subtle": "#FFF5DF"
      },
      "danger": {
        "default": "#B54858",
        "subtle": "#FFF0F2"
      },
      "overlay": "rgba(27, 24, 36, 0.44)"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": [
        "Geist Sans",
        "Noto Sans SC",
        "Microsoft YaHei UI",
        "PingFang SC",
        "system-ui",
        "sans-serif"
      ],
      "mono": ["Geist Mono", "SFMono-Regular", "Consolas", "Liberation Mono", "monospace"]
    },
    "fontSize": {
      "display": "clamp(2.5rem, 5vw, 4.25rem)",
      "h1": "clamp(2.125rem, 4vw, 3.25rem)",
      "h2": "2rem",
      "h3": "1.5rem",
      "title": "1.125rem",
      "bodyLg": "1rem",
      "body": "0.875rem",
      "label": "0.8125rem",
      "caption": "0.75rem"
    },
    "lineHeight": {
      "display": 1.04,
      "heading": 1.16,
      "title": 1.35,
      "body": 1.65,
      "compact": 1.4
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letterSpacing": {
      "display": "-0.035em",
      "heading": "-0.02em",
      "label": "0.01em"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem",
    "32": "8rem"
  },
  "radius": {
    "xs": "0.375rem",
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "xl": "1.5rem",
    "pill": "999px"
  },
  "borderWidth": {
    "hairline": "1px",
    "emphasis": "2px"
  },
  "shadow": {
    "xs": "0 1px 2px rgba(27, 24, 36, 0.05)",
    "sm": "0 6px 18px rgba(27, 24, 36, 0.07)",
    "md": "0 16px 40px rgba(27, 24, 36, 0.10)",
    "focus": "0 0 0 3px rgba(139, 111, 232, 0.28)"
  },
  "layout": {
    "containerMax": "90rem",
    "contentMax": "75rem",
    "readingMax": "45rem",
    "gutter": {
      "mobile": "1rem",
      "tablet": "1.5rem",
      "desktop": "2rem"
    },
    "headerHeight": {
      "mobile": "3.5rem",
      "desktop": "4rem"
    },
    "heroMinHeightDesktop": "31rem",
    "breakpoint": {
      "sm": "40rem",
      "md": "48rem",
      "lg": "64rem",
      "xl": "75rem",
      "2xl": "90rem"
    }
  },
  "componentSize": {
    "controlHeight": {
      "sm": "2.25rem",
      "md": "2.75rem",
      "lg": "3rem"
    },
    "touchTargetMin": "2.75rem",
    "icon": {
      "sm": "1rem",
      "md": "1.25rem",
      "lg": "1.5rem"
    },
    "avatar": {
      "sm": "1.5rem",
      "md": "2rem",
      "lg": "2.5rem"
    }
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "base": "180ms",
      "slow": "240ms",
      "emphasis": "360ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "zIndex": {
    "base": 0,
    "sticky": 20,
    "header": 30,
    "drawer": 50,
    "modal": 60,
    "toast": 70,
    "tooltip": 80
  }
}
